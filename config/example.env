# Load with: set -a; . config/example.env; set +a
LISTEN_ADDR=:8080
ADMIN_ADDR=:9090
BACKENDS=http://localhost:8081,http://localhost:8082,http://localhost:8083
BALANCER_STRATEGY=round_robin
MAX_ATTEMPTS=3
UPSTREAM_TIMEOUT=5s
DIAL_TIMEOUT=1s
HEALTH_INTERVAL=5s
HEALTH_TIMEOUT=1s
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=20s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=25s
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_MAX_CLIENTS=100000
RATE_LIMIT_IDLE_TTL=5m
RATE_LIMIT_CLEANUP_INTERVAL=1m
# Empty means forwarding headers cannot override the direct peer address.
TRUSTED_PROXY_CIDRS=
